# ---- LLM provider ----
# One of: mistral | azure | ollama
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest

MISTRAL_API_KEY=

# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings (local, no API key needed) ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nl2sql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# Read-only role used by the agent to execute generated SQL
READONLY_USER=nl2sql_reader
READONLY_PASSWORD=changeme
STATEMENT_TIMEOUT_MS=10000

# ---- Agent behaviour ----
MAX_REPAIRS=3
RETRIEVAL_TOP_K=10
FORCED_ROW_LIMIT=1000
EXPLAIN_COST_THRESHOLD=1000000

# ---- Observability ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MLFLOW_TRACKING_URI=http://localhost:5000
